{
  "name": "director-stage-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D 导演台融合 Demo — 多角色 GLB 摆姿 + 几何道具 + 取景截图",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-imports.mjs",
    "test:e2e": "node selftest.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "docs:ai": "node scripts/gen-ai-vocab.mjs",
    "test:e2e:all": "node selftest.mjs all",
    "check": "npm run lint && npm run test:unit",
    "test:e2e:required": "node scripts/run-e2e.mjs required",
    "test:browser:install": "node scripts/install-test-browser.mjs",
    "test:build": "node scripts/check-build.mjs && node scripts/test-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@puppeteer/browsers": "3.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "gltfpack": "1.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.2.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "immer": "11.2.3",
    "mp4-muxer": "5.2.2",
    "three": "^0.160.0"
  }
}
